<h1><%= @post.title %></h1>

<p><%= @post.body %></p>

<% if @post.user_id == current_user.id %>
  <%= link_to "編集", edit_post_path(@post) %>
  <%= link_to "削除", post_path(@post),
              method: :delete,
              data: { confirm: "本当に削除しますか？" } %> <!-- # 削除前にアラート -->
<% end %>

<%= link_to "一覧へ戻る", posts_path %>
