<h1>管理者投稿一覧</h1>

<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>タイトル</th>
      <th>投稿者</th>
      <th>日時</th>
      <th>詳細</th>
    </tr>
  </thead>

  <tbody>
    <% @posts.each do |post| %>
      <tr>
        <td><%= post.id %></td>
        <td><%= post.title %></td>

        <td>
          <% if post.user.present? %>
            <%= post.user.name %>
            # ここに追加
          <% else %>
            管理者：<%= post.admin.name %>
          <% end %>
        </td>

        <td><%= post.created_at.strftime("%Y-%m-%d %H:%M:%S") %></td>
        <td><%= link_to "詳細", admin_post_path(post) %></td>
      </tr>
    <% end %>
  </tbody>
</table>