<h1>管理者投稿作成</h1>

<%= form_with model: @post, url: admin_posts_path, local: true do |f| %>
  <p>タイトル</p>
  <%= f.text_field :title %>

  <p>本文</p>
  <%= f.text_area :body %>

  <p>獲得できるポイント</p>
  <%= f.collection_select :category_id, Category.all, :id, :name, prompt: "選択してください" %>

  <%= f.submit "投稿する" %>
<% end %>

<%= link_to "管理者マイページへ戻る", admin_root_path %>