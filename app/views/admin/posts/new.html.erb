<h1>管理者投稿作成</h1>

<%= form_with model: @post, url: admin_posts_path, local: true do |f| %>
  <p>タイトル</p>
  <%= f.text_field :title %>

  <p>本文</p>
  <%= f.text_area :body, class: "admin-body-field" %>

  <div>
    <%= f.label :purpose_id, "目的" %>
    <%= f.collection_select :purpose_id,
      Purpose.all, :id, :name,
      prompt: "目的を選択してください" %>
  </div>

  <p>獲得できるポイント</p>
  <%= f.collection_select :category_id,
      Category.for_post_select, :id, :name,
      prompt: "選択してください" %>

  <div id="sub_category_area" style="display:none;">
    <%= f.label :sub_category_id, "サブカテゴリ" %>

      <% other_category = Category.find_by(name: "その他ポイント") || Category.find_by(name: "その他カテゴリ") %>
      <% sub_categories = other_category ? SubCategory.where(category_id: other_category.id, purpose_id: nil) : SubCategory.none %>
    <%= f.collection_select :sub_category_id,
        sub_categories,
          :id, :name,
          prompt: "選択してください" %>
  </div>

  <script>
    document.addEventListener("input", function() {
      const categorySelect = document.getElementById("post_category_id");
      const area = document.getElementById("sub_category_area");

      if (["その他ポイント", "その他カテゴリ"].includes(categorySelect.selectedOptions[0].text)) {
        area.style.display = "block";
      } else {
        area.style.display = "none";
      }
    });
  </script>

  <%= f.submit "投稿する" %>
<% end %>
