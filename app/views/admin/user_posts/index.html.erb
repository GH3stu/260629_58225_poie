<h1>ユーザー投稿一覧（管理者専用）</h1>

<table border="1" cellpadding="8">
  <tr>
    <th>ID</th>
    <th>タイトル</th>
    <th>投稿者</th>
    <th>日時</th>
    <th>詳細</th>
  </tr>

  <% @posts.each do |post| %>
    <tr>
      <td><%= post.id %></td>
      <td><%= post.title %></td>
      <td><%= post.user.name %></td>
      <td><%= post.created_at.strftime("%Y-%m-%d %H:%M:%S") %></td>
      <td><%= link_to "詳細", admin_user_post_path(post) %></td>
    </tr>
  <% end %>
</table>

<%= link_to "管理者マイページへ戻る", admin_root_path %>
