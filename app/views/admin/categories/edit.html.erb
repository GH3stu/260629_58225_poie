<h1>カテゴリ編集</h1>

<%= form_with model: @category, url: admin_category_path(@category), local: true do |f| %>
  <div>
    <%= f.label :name, "カテゴリ名" %><br>
    <%= f.text_field :name %>
  </div>

  <div style="margin-top: 10px;">
    <%= f.submit "更新する" %>
  </div>
<% end %>

<%= link_to "カテゴリ一覧へ戻る", admin_categories_path %>
