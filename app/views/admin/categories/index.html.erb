<h1>カテゴリ一覧</h1>

<%= link_to "新規カテゴリ追加", new_admin_category_path %>

<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>カテゴリ名</th>
      <th>操作</th>
    </tr>
  </thead>

  <tbody>
    <% @categories.each do |category| %>
      <tr>
        <td><%= category.id %></td>
        <td><%= category.name %></td>
        <td>
          <%= link_to "編集", edit_admin_category_path(category) %>
          <%= link_to "削除", admin_category_path(category),
                data: { turbo_method: :delete, confirm: "削除しますか？" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
