<h1>カテゴリ一覧</h1>

<p>カテゴリは固定します。編集または削除する場合は注意してください</p>

<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>カテゴリ名</th>
      <th>サブカテゴリ名</th>
    </tr>
  </thead>

  <tbody>
    <% @categories.each do |category| %>
      <tr>
        <td><%= category.id %></td>
        <td><%= category.name %></td>
        <td>
          <% if category.name == "その他ポイント" %>
            <%= category.sub_categories.pluck(:name).join(", ") %>
          <% else %>
            -
          <% end %>
        </td>

        <td>
          <%= link_to "編集", edit_admin_category_path(category) %>
          <%= link_to "削除", admin_category_path(category),
                data: { turbo_method: :delete, confirm: "削除しますか？" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<br><br>

<%= link_to "管理者マイページへ戻る", admin_root_path %>
