<h1>管理者ログイン</h1>

<%= form_with url: admin_login_path, method: :post, scope: nil, local: true do |f| %>
  <p>
    <%= f.label :email, "メールアドレス" %><br>
    <%= f.text_field :email %>
  </p>

  <p>
    <%= f.label :password, "パスワード" %><br>
    <%= f.password_field :password %>
  </p>

  <%= f.submit "ログイン" %>
<% end %>
