<h2>タグ一覧</h2>

<table border="1" cellpadding="8" style="width: 60%;">
  <tr>
    <th>ID</th>
    <th>タグ名</th>
    <th>紐づく投稿数</th>
    <th>操作</th>
  </tr>

  <% @tags.each do |tag| %>
    <tr>
      <td><%= tag.id %></td>
      <td><%= tag.name %></td>
      <td><%= tag.posts.count %></td>
      <td>
        <%= link_to "削除",
            admin_tag_path(tag),
            data: { turbo_method: :delete, confirm: "削除しますか？" } %>
      </td>
    </tr>
  <% end %>
</table>

<br>

<%= link_to "管理者マイページへ戻る", admin_root_path %>
