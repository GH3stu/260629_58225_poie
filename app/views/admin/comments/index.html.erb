<h1>コメント一覧</h1>

<table border="1" cellpadding="8">
  <tr>
    <th>ID</th>
    <th>内容</th>
    <th>投稿者</th>
    <th>対象投稿</th>
    <th>日時</th>
    <th>詳細</th>
  </tr>

  <% @comments.each do |comment| %>
    <tr>
      <td><%= comment.id %></td>
      <td><%= truncate(comment.body, length: 50) %></td>

      <!-- 投稿者の分岐 -->
      <td>
        <% if comment.user.present? %>
          <%= comment.user.name %>   <!-- ユーザーコメント -->
        <% else %>
          管理者：<%= comment.admin.name %>   <!-- 管理者コメント -->
        <% end %>
      </td>

      <td><%= link_to comment.post.title, admin_post_path(comment.post) %></td>
      <td><%= comment.created_at.strftime("%Y-%m-%d %H:%M:%S") %></td>
      <td><%= link_to "詳細", admin_comment_path(comment) %></td>
    </tr>
  <% end %>
</table>

<%= link_to "管理者マイページへ戻る", admin_root_path %>
