<h3 style="color: #65b844;"><%= @category.name %></h3>

<% if @category.name == "その他ポイント" %>

<br>

  <h4 style="color: #65b844;">サブカテゴリ一覧</h4>

  <div class="category-sub-table-wrap">
    <table class="category-sub-table">
      <thead>
        <tr>
        <th>サブカテゴリ名</th>
        </tr>
      </thead>

      <tbody>
        <% if @sub_categories.present? %>
          <% @sub_categories.each do |sc| %>
            <tr>
            <td><%= sc.name %></td>

            <td class="list-action-cell">
              <%= link_to "投稿一覧", sub_category_posts_path(sc.id),
                class: "list-detail-btn" %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="2">サブカテゴリはありません</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="category-posts-table-wrap">
    <table class="category-posts-table">
      <thead>
        <tr>
        <th>日時</th>
        <th>投稿タイトル</th>
        <th>投稿者</th>
        </tr>
      </thead>
      <tbody>
        <% @posts.each do |post| %>
          <tr>
          <td><%= post.created_at.strftime("%Y-%m-%d %H:%M") %></td>
          <td><%= post.title %></td>

          <td>
            <% if post.user.present? %>
              <%= post.user.name %>
            <% else %>
              poier
            <% end %>
          </td>

          <td>
            <% if current_user.present? %>
              <%= link_to "詳細", user_post_path(post),
                class: "list-detail-btn" %>
            <% else %>
              <%= link_to "詳細", login_path,
                class: "list-detail-btn" %>
            <% end %>
          </td>

          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
