<h3 style="color: #65b844;"><%= @purpose.name %></h3>

<table style="width:100%; border-collapse: collapse; color: #65b844; margin-top:20px;">
  <thead>
    <tr style="border-bottom: 2px solid #65b844;">
      <th>カテゴリ名</th>
      <th>投稿一覧へ</th>
    </tr>
  </thead>

  <tbody>
    <% @categories.each do |category| %>
      <tr style="border-bottom: 1px solid #65b844;">
        <td><%= category.name %></td>

        <td>
          <%= link_to "見る", category_posts_path(category),
            style: "
              display:inline-block;
              padding:6px 12px;
              background-color: #65b844;
              color: #fff;
              border-radius:999px;
              text-decoration:none;
            " %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
