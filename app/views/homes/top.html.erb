<h5 style="color: #65b844;">poieへようこそ!</h5>

<br>

<h3 style="color: #008000;">目的から探す</h3>

<br>

<div style="border: 0px solid #CCFFCC; background-color: #FFF; padding: 30px; width: 100%; margin: 0 auto;">

  <div style="display: flex; justify-content: center; gap: 80px;">

    <% @purposes.each do |purpose| %>

      <% image_name =
        case purpose.name
        when "買い物"
          "shopping.png"
        when "移動"
          "move.png"
        when "スマホ・通信"
          "mobile.png"
        when "カード・金融"
          "card.png"
        when "デジタル"
          "digital.png"
        when "生活"
          "life.png"
        when "その他"
          "other.png"
        else
          "other.png"
        end
      %>

      <%= link_to purpose_posts_path(purpose), style: "text-decoration: none;" do %>
        <div style="text-align: center;">
          <%= image_tag image_name, style: "width: 100px; height: 100px;" %>
          <div style="margin-top: 10px; font-size: 14px; color:#333;">
            <%= purpose.name %>
          </div>
        </div>
      <% end %>

    <% end %>

  </div>
</div>

<br><br>

<h5 style="color: #65b844;">最新の投稿</h5>

<table style="width:100%; border-collapse: collapse; color: #65b844; margin-top:20px;">
  <thead>
    <tr style="border-bottom: 2px solid #65b844;">
      <th>日時</th>
      <th>タイトル</th>
      <th>投稿者</th>
      <th>詳細</th>
    </tr>
  </thead>

  <tbody>
    <% @admin_posts.each do |post| %>
      <tr style="border-bottom: 1px solid #65b844;">
        
        <!-- 日時 -->
        <td><%= post.created_at.strftime("%Y-%m-%d %H:%M") %></td>

        <!-- タイトル -->
        <td><%= post.title %></td>

        <!-- 投稿者 -->
        <td>
          <% if post.user.present? %>
            <%= post.user.name %>
          <% else %>
            管理者：<%= post.admin.name %>
          <% end %>
        </td>

        <!-- 詳細リンク（ログイン状態で分岐） -->
        <td>
          <% if current_user.present? %>
            <%= link_to "詳細", user_post_path(post),
              style: "
                display:inline-block;
                padding:6px 12px;
                background-color: #65b844;
                color:#fff;
                border-radius:999px;
                text-decoration:none;
              " %>
          <% else %>
            <%= link_to "詳細", login_path,
              style: "
                display:inline-block;
                padding:6px 12px;
                background-color: #65b844;
                color:#fff;
                border-radius:999px;
                text-decoration:none;
              " %>
          <% end %>
        </td>

      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= paginate @admin_posts %>