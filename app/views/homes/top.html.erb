<h5>poieへようこそ!</h5>

<br>

<h3>目的から探す</h3>

<br>

<div style="display: flex; justify-content: center; gap: 24px; margin-top: 20px;">
  <% @purposes.each do |purpose| %>
    <div style="border: 0px solid #CCFFCC; background-color: #F7FBEF; padding: 28px; width: 120px; text-align: center;">
      <%= link_to purpose.name, purpose_posts_path(purpose.id), style: "text-decoration: none; font-size: 16px;" %>
    </div>
  <% end %>
</div>

<br><br>

<h5>最新の投稿</h5>

<% @admin_posts.each do |post| %>
  <div style="border:1px solid #ccc; padding:10px; margin-bottom:10px;">
    <p><%= post.created_at.strftime("%Y-%m-%d %H:%M:%S") %></p>
    <p>タイトル：<%= post.title %></p>
    <p>本文：<%= simple_format(url_to_link(post.body.delete('"'))) %></p>

    <%= link_to "投稿詳細を見る", admin_post_path(post) %>
  </div>
<% end %>

<%= paginate @admin_posts %> 
