<h5>poieへようこそ!</h5>

<br>

<h3>目的から探す</h3>

<br>

<div style="border: 0px solid #CCFFCC; background-color: #FFF; padding: 30px; width: 100%; margin: 0 auto;">

  <div style="display: flex; justify-content: center; gap: 80px;">

    <% @purposes.each do |purpose| %>

      <% image_name =
        case purpose.name
        when "買い物"
          "shopping.png"
        when "移動"
          "move.png"
        when "スマホ・通信"
          "mobile.png"
        when "カード・金融"
          "card.png"
        when "デジタル"
          "digital.png"
        when "生活"
          "life.png"
        when "その他"
          "other.png"
        else
          "other.png"
        end
      %>

      <%= link_to purpose_posts_path(purpose), style: "text-decoration: none;" do %>
        <div style="text-align: center;">
          <%= image_tag image_name, style: "width: 100px; height: 100px;" %>
          <div style="margin-top: 10px; font-size: 14px; color:#333;">
            <%= purpose.name %>
          </div>
        </div>
      <% end %>

    <% end %>

  </div>
</div>

<br><br>

<h5>最新の投稿</h5>

<br>

<% @admin_posts.each do |post| %>
  <div style="border:1px solid #ccc; padding:10px; margin-bottom:10px;">

    <div style="
      font-size:18px;
      font-weight:bold;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    ">
      
      <!-- 日時（リンク化しない） -->
      <span style="color:#666; font-size:14px;">
        <%= post.created_at.strftime("%Y-%m-%d %H:%M") %>
      </span>

      <!-- 題名（リンク化する：ログイン状態で分岐） -->
      <% if current_user.present? %>
        <%= link_to post.title, user_post_path(post),
          style: "margin-left: 8px; color:#000; text-decoration:none;" %>
      <% else %>
        <%= link_to post.title, login_path,
          style: "margin-left: 8px; color:#000; text-decoration:none;" %>
      <% end %>
    </div>
  </div>
<% end %>

<%= paginate @admin_posts %>
