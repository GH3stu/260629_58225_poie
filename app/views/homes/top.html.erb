<h1>Poie トップ</h1>
<p>レビュー投稿型コミュニティへようこそ。</p>

<h1>目的から探す</h1>

<div style="display: flex; flex-wrap: wrap; gap: 20px; margin-top: 20px;">
  <% @purposes.each do |purpose| %>
    <div style="border: 1px solid #ddd; padding: 20px; width: 250px; text-align: center;">
      <%= link_to purpose.name, purpose_posts_path(purpose.id), style: "text-decoration: none; font-size: 18px;" %>
    </div>
  <% end %>
</div>

<h2>poier投稿</h2>

<% @admin_posts.each do |post| %>
  <div style="border:1px solid #ccc; padding:10px; margin-bottom:10px;">
    <p><%= post.created_at.strftime("%Y-%m-%d %H:%M:%S") %></p>
    <p>タイトル：<%= post.title %></p>
    <p>本文：<%= simple_format(url_to_link(post.body.delete('"'))) %></p>

    <%= link_to "投稿詳細を見る", admin_post_path(post) %>
  </div>
<% end %>
