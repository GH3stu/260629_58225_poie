<h5 class="top-welcome">poieへようこそ!</h5>

<br>

<h3 class="top-purpose-title">目的から探す</h3>

<br>

<div class="top-purpose-card">
  <div class="top-purpose-list">

    <% @purposes.each do |purpose| %>

      <% image_name =
        case purpose.name
        when "買い物"
          "shopping.png"
        when "移動"
          "move.png"
        when "スマホ・通信"
          "mobile.png"
        when "カード・金融"
          "card.png"
        when "デジタル"
          "digital.png"
        when "生活"
          "life.png"
        when "その他"
          "other.png"
        else
          "other.png"
        end
      %>

      <%= link_to purpose_posts_path(purpose), class: "top-purpose-link" do %>
        <div class="top-purpose-item">
          <%= image_tag image_name, class: "top-purpose-icon", alt: purpose.name %>
          <div class="top-purpose-name">
            <%= purpose.name %>
          </div>
        </div>
      <% end %>

    <% end %>

  </div>
</div>

<br><br>

<h5 class="top-latest-title">最新の投稿</h5>

<div class="top-posts-table-wrap">
  <table class="top-posts-table">
    <thead>
      <tr>
        <th>日時</th>
        <th>タイトル</th>
        <th>投稿者</th>
      </tr>
    </thead>

    <tbody>
      <% @admin_posts.each do |post| %>
        <tr>
        
        <!-- 日時 -->
        <td><%= post.created_at.strftime("%Y-%m-%d %H:%M") %></td>

        <!-- タイトル -->
        <td><%= post.title %></td>

        <!-- 投稿者 -->
        <td>
          <% if post.user.present? %>
            <%= post.user.name %>
          <% else %>
            poier
          <% end %>
        </td>

        <!-- 詳細リンク（ログイン状態で分岐） -->
          <td>
            <% if current_user.present? %>
              <%= link_to "詳細", user_post_path(post), class: "top-post-detail-btn" %>
            <% else %>
              <%= link_to "詳細", login_path, class: "top-post-detail-btn" %>
            <% end %>
          </td>

        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<br>

<div class="top-pagination">
  <%= paginate @admin_posts %>
</div>
