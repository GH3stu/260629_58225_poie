<h3 style="color: #65b844;">検索結果</h3>

<br>

<p style="color: #65b844;">検索ワード：<%= @keyword %></p>

<hr style="border-color: #65b844;">

<% if @results.present? %>

  <% if @target == "users" %>

    <!-- ユーザー検索結果 -->
    <div class="search-users-table-wrap">
      <table class="search-users-table">
        <thead>
          <tr>
          <th>ユーザー名</th>
          <th>詳細</th>
          </tr>
        </thead>

        <tbody>
          <% @results.each do |item| %>
            <tr>
            <td><%= item.name %></td>
            <td class="list-action-cell">
              <%= link_to "ユーザー詳細", user_user_path(item),
                class: "list-detail-btn" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

  <% else %>

    <!-- 投稿検索結果 -->
    <div class="search-posts-table-wrap">
      <table class="search-posts-table">
        <thead>
          <tr>
            <th>日時</th>
            <th>投稿タイトル</th>
            <th>投稿者</th>
          </tr>
        </thead>

        <tbody>
          <% @results.each do |item| %>
            <tr>

              <!-- 日時 -->
              <td><%= item.created_at.strftime("%Y-%m-%d %H:%M") %></td>

              <!-- タイトル -->
              <td><%= item.title %></td>

              <!-- 投稿者（共通ロジック） -->
              <td>
                <% if item.user.present? %>
                  <%= item.user.name %>
                <% else %>
                  poier
                <% end %>
              </td>

              <!-- 詳細 -->
              <td class="list-action-cell">
                <%= link_to "投稿詳細", user_post_path(item),
                  class: "list-detail-btn" %>
              </td>

            </tr>
          <% end %>
        </tbody>
      </table>
    </div>


  <% end %>

<% else %>

  <p style="color: #65b844;">該当する結果はありません。</p>

<% end %>

<br>

<%= link_to "トップへ戻る", root_path, style:"color: #65b844;" %>