<h2 style="color: #65b844;">タグ：<%= @tag.name %></h2>

<p style="color:#65b844;">
  このタグが付いた投稿一覧（<%= @posts.count %>件）
</p>

<hr style="border-color: #65b844;">

<% @posts.each do |post| %>
  <div style="
    background-color: #F7FBEF;
    padding:15px;
    margin-bottom:20px;
    color:#65b844;
  ">

    <h3>
      <%= link_to post.title, user_post_path(post), style:"color: #008000;" %>
    </h3>

    <p><%= truncate(post.body, length:120) %></p>

    <p>投稿者：<%= post.author_name %></p>
    <p>投稿日時：<%= post.created_at.strftime("%Y-%m-%d %H:%M:%S") %></p>

    <p>
      タグ：
      <% post.tags.each do |tag| %>
        <%= link_to tag.name, user_tag_path(tag),
            style:"
              margin-right:6px;
              padding:3px 6px;
              background: #65b844;
              color:#fff;
              border-radius:999px;
            "
        %>
      <% end %>
    </p>

  </div>
<% end %>

<br>

<%= link_to "投稿一覧へ戻る", user_posts_path, style: "color: #65b844;" %>
