<h2 style="color: #65b844;">投稿編集</h2>

<br>

<%= form_with model: @post, url: user_post_path(@post), method: :patch, local: true do |f| %>

<div class="post-editor-layout post-editor-layout--split">

  <!-- 左側：フォーム -->
  <div class="post-editor-panel">

      <% if @post.errors.any? %>
        <ul style="color:red;">
          <% @post.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      <% end %>

      <!-- タイトル -->
      <div>
        <%= f.label :title, "タイトル", style:"color: #65b844;" %><br>
        <%= f.text_field :title,
              style:"width:100%; border:1px solid #65b844; padding:6px;" %>
      </div>

      <br>

      <!-- 本文 -->
      <div>
        <%= f.label :body, "本文", style:"color: #65b844;" %><br>
        <%= f.text_area :body,
              style:"width:100%; height:120px; border:1px solid #65b844; padding:6px;" %>
      </div>

      <br>

      <!-- 目的 -->
      <div>
        <%= f.label :purpose_id, "目的", style:"color: #65b844;" %><br>
        <%= f.collection_select :purpose_id,
              Purpose.all, :id, :name,
              prompt:"目的を選択してください",
              style:"width:100%; border:1px solid #65b844; padding:6px;" %>
      </div>

      <br>

      <!-- 獲得できるポイント -->
      <div>
        <%= f.label :category_id, "獲得できるポイント", style:"color: #65b844;" %><br>
        <%= f.collection_select :category_id,
              Category.for_post_select, :id, :name,
              prompt:"選択してください",
              style:"width:100%; border:1px solid #65b844; padding:6px;" %>
      </div>

      <br>

      <!-- サブカテゴリ -->
      <div id="sub_category_area"
         style="<%= ["その他ポイント", "その他カテゴリ"].include?(@post.category&.name) ? '' : 'display:none;' %>">
        <%= f.label :sub_category_id, "サブカテゴリ", style:"color: #65b844;" %><br>
        <%= f.collection_select :sub_category_id,
              SubCategory.all, :id, :name,
              prompt:"選択してください",
              style:"width:100%; border:1px solid #65b844; padding:6px;" %>
      </div>

      <script>
        document.addEventListener("input", function() {
          const categorySelect = document.getElementById("post_category_id");
          const area = document.getElementById("sub_category_area");

          if (["その他ポイント", "その他カテゴリ"].includes(categorySelect.selectedOptions[0].text)) {
            area.style.display = "block";
          } else {
            area.style.display = "none";
          }
        });
      </script>

      <br>

      <!-- タグ追加（テキスト） -->
      <div>
        <%= f.label :tag_names, "タグを追加（カンマ区切り）", style:"color: #65b844;" %><br>
        <%= f.text_field :tag_names,
              style:"width:100%; border:1px solid #65b844; padding:6px;" %>
        <p style="font-size:12px; color: #65b844;">
          ※「#」は自動で付与されます。
        </p>
      </div>

      <br>

      <%= f.submit "更新する",
        style:"
          width:100%;
          padding:10px 0;
          background-color: #65b844;
          color:#fff;
          border:none;
          border-radius:999px;
          font-size:16px;
          cursor:pointer;
        "
      %>
  </div>

  <!-- 右側：タグ一覧 -->
  <div class="post-tag-panel">
    <div>
      <span style="color:#65b844;">タグを選択（複数選択可）</span><br>

      <div class="row post-tag-grid" style="margin-top:10px;">
        <% Tag.all.each do |tag| %>
          <div class="col-4 mb-2">
            <label style="
              display:flex;
              align-items:center;
              background:#F7FBEF;
              border:none;
              padding:8px;
              border-radius:6px;
              color:#65b844;
            ">
              <%= check_box_tag "post[tag_ids][]", tag.id, @post.tags.include?(tag) %>
              <span style="margin-left:8px; color:#65b844;"><%= tag.name %></span>
            </label>
          </div>
        <% end %>
      </div>
    </div>
  </div>

</div>

<% end %>

<br>

<%= link_to "マイページへ戻る",
      user_user_path(current_user),
      style:"color: #65b844;" %>