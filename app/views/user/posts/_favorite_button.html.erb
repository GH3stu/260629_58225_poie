<div id="favorite_button" style="margin-top:15px;">
  <% if current_user && post.user_id != current_user.id %>
    <div style="
      display:inline-block;
      padding:10px 20px;
      background:#65b844;
      color:#fff;
      border-radius:999px;
      text-decoration:none;
    ">
      <% if favorite %>
        <%= link_to user_post_favorite_path(post, favorite),
            data: { turbo_method: :delete },
            style: "color:#fff; text-decoration:none;" do %>
          ★ お気に入り解除
        <% end %>
      <% else %>
        <%= link_to user_post_favorites_path(post),
            data: { turbo_method: :post },
            style: "color:#fff; text-decoration:none;" do %>
          ☆ お気に入り
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
