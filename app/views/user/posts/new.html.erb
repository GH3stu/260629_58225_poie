<h2>新規投稿</h2>

<br>

<!-- ★ 左端に配置する入力ボックス（プロフィール編集と同じ設定） -->
<div style="width: 40%; height: 70vh; border: 1px solid #FFF; padding: 30px; background-color: #F7FBEF;">

  <%= form_with model: @post, url: user_posts_path, local: true do |f| %>

    <% if @post.errors.any? %>
      <ul>
        <% @post.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    <% end %>

    <div>
      <%= f.label :title, "タイトル" %><br>
      <%= f.text_field :title, style: "width: 100%;" %>
    </div>

    <br>

    <div>
      <%= f.label :body, "本文" %><br>
      <%= f.text_area :body, style: "width: 100%; height: 120px;" %>
    </div>

    <br>

    <div>
      <%= f.label :purpose_id, "目的" %><br>
      <%= f.collection_select :purpose_id,
        Purpose.all, :id, :name,
        prompt: "目的を選択してください",
        style: "width: 100%;" %>
    </div>

    <br>

    <div>
      <%= f.label :category_id, "獲得できるポイント" %><br>
      <%= f.collection_select :category_id,
        Category.for_post_select, :id, :name,
        prompt: "選択してください",
        style: "width: 100%;" %>
    </div>

    <br>

    <div id="sub_category_area" style="display:none;">
      <%= f.label :sub_category_id, "サブカテゴリ" %><br>

      <% other_category = Category.find_by(name: "その他ポイント") %>
      <%= f.collection_select :sub_category_id,
            SubCategory.where(category_id: other_category.id, purpose_id: nil),
            :id, :name,
            prompt: "選択してください",
            style: "width: 100%;" %>
    </div>

    <br>

    <div>
      <%= f.label :tag_ids, "タグを選択（複数選択可）" %><br>

      <% Tag.all.each do |tag| %>
        <label style="display: block;">
          <%= check_box_tag "post[tag_ids][]", tag.id, @post.tags.include?(tag) %>
          <%= tag.name %>
        </label>
      <% end %>
    </div>

    <br>

    <div>
      <%= f.label :tag_names, "タグ（カンマ区切り）" %><br>
      <%= f.text_field :tag_names, style: "width: 100%;" %>
    </div>

    <script>
      document.addEventListener("input", function() {
        const categorySelect = document.getElementById("post_category_id");
        const area = document.getElementById("sub_category_area");

        if (categorySelect.selectedOptions[0].text === "その他ポイント") {
          area.style.display = "block";
        } else {
          area.style.display = "none";
        }
      });
    </script>

    <br>

    <%= f.submit "投稿する", style: "padding: 8px 20px;" %>

  <% end %>

</div>

<br>

<%= link_to "マイページへ戻る", user_user_path(current_user) %>
