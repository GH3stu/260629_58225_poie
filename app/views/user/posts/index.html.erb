<h1>投稿一覧</h1>

<% @posts.each do |post| %>
  <div style="margin-bottom: 20px; border-bottom: 1px solid #ccc; padding-bottom: 10px;">

    <h3><%= link_to post.title, user_post_path(post) %></h3>

    <p><%= simple_format(h(post.body).truncate(50)) %></p>

    <!-- ★ 投稿者の分岐（ここに追加） -->
    <p>
      投稿者：
      <% if post.user.present? %>
        <%= post.user.name %>
      <% else %>
        管理者：<%= post.admin.name %>
      <% end %>
    </p>

    <p>投稿日時：<%= post.created_at.strftime("%Y-%m-%d %H:%M:%S") %></p>

  </div>
<% end %>
