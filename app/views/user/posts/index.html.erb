<h3 style="color: #65b844;">投稿一覧</h3>

<br>

<table style="width:100%; border-collapse: collapse; color: #65b844; margin-top:20px;">
  <thead>
    <tr style="border-bottom: 2px solid #65b844;">
      <th>日時</th>
      <th>投稿</th>
      <th>投稿者</th>
      <th>詳細</th>
    </tr>
  </thead>

  <tbody>
    <% @posts.each do |post| %>
      <tr style="border-bottom: 1px solid #65b844;">

        <!-- 日時 -->
        <td><%= post.created_at.strftime("%Y-%m-%d %H:%M:%S") %></td>

        <!-- タイトル -->
        <td><%= post.title %></td>

        <!-- 投稿者（ユーザー or 管理者） -->
        <td>
          <% if post.user.present? %>
            <%= post.user.name %>
          <% else %>
            管理者：<%= post.admin.name %>
          <% end %>
        </td>

        <!-- 詳細ボタン -->
        <td>
          <%= link_to "詳細", user_post_path(post),
            style: "
              display:inline-block;
              padding:6px 12px;
              background-color: #65b844;
              color:#fff;
              border-radius:999px;
              text-decoration:none;
            " %>
        </td>

      </tr>
    <% end %>
  </tbody>
</table>
