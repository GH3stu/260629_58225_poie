<h3 style="color:#65b844;">投稿一覧</h3>

<br><br>

<% @posts.each do |post| %>
  <div style="
    padding:15px;
    margin-bottom:20px;
    background-color: #F7FBEF;
    color: #65b844;
  ">

    <h3>
      <%= link_to post.title, user_post_path(post), style:"color: #008000;" %>
    </h3>

    <p><%= simple_format(h(post.body).truncate(100)) %></p>

    <p>
      投稿者：
      <% if post.user.present? %>
        <%= post.user.name %>
      <% else %>
        管理者：<%= post.admin.name %>
      <% end %>
    </p>

    <p>投稿日時：<%= post.created_at.strftime("%Y-%m-%d %H:%M:%S") %></p>

  </div>
<% end %>

<%= link_to "マイページへ戻る", user_user_path(current_user), style:"color: #65b844;" %>
