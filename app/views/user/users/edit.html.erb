<h1>ユーザー情報編集</h1>

<%= form_with model: @user, url: user_user_path(@user), method: :patch, local: true do |f| %>

  <% if @user.errors.any? %>
    <ul>
      <% @user.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  <% end %>

  <div>
    <%= f.label :name, "ユーザー名" %>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :email, "メールアドレス" %>
    <%= f.email_field :email %>
  </div>

  <div>
    <%= f.label :password, "パスワード（変更する場合のみ）" %>
    <%= f.password_field :password %>
  </div>

  <div>
    <%= f.label :password_confirmation, "パスワード確認" %>
    <%= f.password_field :password_confirmation %>
  </div>

  <%= f.submit "更新する" %>
<% end %>

<br>

<%= link_to "マイページへ戻る", user_user_path(@user) %>
