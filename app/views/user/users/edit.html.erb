<h2>プロフィール編集</h2>

<br>

<!-- 左端に配置する入力用ボックス -->
<div style="width: 40%; height: 60vh; border: 1px solid #FFF; padding: 30px; background-color: #F7FBEF;">

  <%= form_with model: @user, url: user_user_path(@user), method: :patch, local: true do |f| %>

    <% if @user.errors.any? %>
      <ul>
        <% @user.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    <% end %>

    <div>
      <%= f.label :name, "ユーザー名" %><br>
      <%= f.text_field :name, style: "width: 100%;" %>
    </div>

    <br>

    <div>
      <%= f.label :email, "メールアドレス" %><br>
      <%= f.email_field :email, style: "width: 100%;" %>
    </div>

    <br>

    <div>
      <%= f.label :password, "パスワード（変更する場合のみ）" %><br>
      <%= f.password_field :password, style: "width: 100%;" %>
    </div>

    <br>

    <div>
      <%= f.label :password_confirmation, "パスワード確認" %><br>
      <%= f.password_field :password_confirmation, style: "width: 100%;" %>
    </div>

    <br>

    <%= f.submit "更新する", style: "padding: 8px 20px;" %>

  <% end %>

</div>

<br>

<%= link_to "マイページへ戻る", user_user_path(@user) %>
