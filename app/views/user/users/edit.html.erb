<h2 style="color: #65b844;">プロフィール編集</h2>

<br>

<div style="
  width: 40%;
  height: 60vh;
  border: 1px solid #65b844;
  padding: 30px;
  background-color: #F7FBEF;
  color: #65b844;
">

  <%= form_with model: @user, url: user_user_path(@user), method: :patch, local: true do |f| %>

    <% if @user.errors.any? %>
      <ul style="color: red;">
        <% @user.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    <% end %>

    <div>
      <%= f.label :name, "ユーザー名", style: "color:#65b844;" %><br>
      <%= f.text_field :name,
            style: "width: 100%; border:1px solid #65b844; padding:6px;" %>
    </div>

    <br>

    <div>
      <%= f.label :email, "メールアドレス", style: "color:#65b844;" %><br>
      <%= f.email_field :email,
            style: "width: 100%; border:1px solid #65b844; padding:6px;" %>
    </div>

    <br>

    <div>
      <%= f.label :password, "パスワード（変更する場合のみ）", style: "color:#65b844;" %><br>
      <%= f.password_field :password,
            style: "width: 100%; border:1px solid #65b844; padding:6px;" %>
    </div>

    <br>

    <div>
      <%= f.label :password_confirmation, "パスワード確認", style: "color:#65b844;" %><br>
      <%= f.password_field :password_confirmation,
            style: "width: 100%; border:1px solid #65b844; padding:6px;" %>
    </div>

    <br>

    <%= f.submit "更新する",
      style: "
        width: 100%;
        padding: 10px 0;
        background-color: #65b844;
        color: #fff;
        border: none;
        border-radius: 999px;
        font-size: 16px;
        text-align: center;
        cursor: pointer;
      "
    %>

  <% end %>

</div>

<br>

<%= link_to "マイページへ戻る", user_user_path(@user), style: "color:#65b844;" %>
