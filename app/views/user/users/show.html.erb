<% if @user.id == current_user.id %>

  <div class="container mt-4">
    <div class="row mb-4">
      <div class="col-12">
        <h3 class="mb-0"><%= @user.name %> さんのお部屋</h3>
      </div>
    </div>

    <div class="row gy-4">
      <div class="col-lg-4">
        <div class="card h-100 shadow-sm" style="background-color: #F7FBEF;">
          <div class="card-body d-flex flex-column gap-3">
            <div>
              <p class="mb-2 fw-semibold">新規投稿</p>
              <%= link_to "投稿する", new_user_post_path, class: "btn btn-primary w-100" %>
            </div>

            <div>
              <p class="mb-2 fw-semibold">投稿一覧</p>
              <%= link_to "確認する", user_posts_path, class: "btn btn-outline-primary w-100" %>
            </div>

            <div>
              <p class="mb-2 fw-semibold">コメント一覧</p>
              <%= link_to "確認する", user_comments_path, class: "btn btn-outline-secondary w-100" %>
            </div>
          </div>
        </div>
      </div>

      <div class="col-lg-8">
        <div class="card h-100 shadow-sm" style="background-color: #F7FBEF;">
          <div class="card-body">
            <div class="row gy-3 mb-4">
              <div class="col-md-6">
                <div class="border rounded-3 p-3 h-100" style="background-color: #FFFFFF;">
                  <h5 class="mb-3">目標</h5>
                  <p class="fs-4 fw-bold mb-0"><%= @user.goal %> pt</p>
                </div>
              </div>
              <div class="col-md-6">
                <div class="border rounded-3 p-3 h-100" style="background-color: #FFFFFF;">
                  <h5 class="mb-3">ポイント残高</h5>
                  <p class="mb-3"><%= @user.points %> pt</p>
                  <h6 class="mb-2">進捗</h6>
                  <% if @progress.present? %>
                    <p class="mb-0"><%= @progress %> %</p>
                  <% else %>
                    <p class="mb-0">-</p>
                  <% end %>
                </div>
              </div>
            </div>

            <div class="border rounded-3 p-3" style="background-color: #FFFFFF;">
              <h5 class="mb-3">ポイント設定</h5>
              <%= form_with model: @user, url: user_user_path(@user), method: :patch do |f| %>
                <div class="row g-3">
                  <div class="col-md-6">
                    <div class="mb-3">
                      <%= f.label :goal, "目標ポイント", class: "form-label" %>
                      <%= f.number_field :goal, class: "form-control" %>
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="mb-3">
                      <%= f.label :points, "現在ポイント", class: "form-label" %>
                      <%= f.number_field :points, class: "form-control" %>
                    </div>
                  </div>
                </div>

                <%= f.submit "更新する", class: "btn btn-primary w-100" %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

<% else %>

  <!-- 他ユーザーの投稿一覧（元コード維持） -->
  <h1><%= @user.name %> の投稿一覧</h1>

  <% @posts.each do |post| %>
    <div>
      <h3><%= link_to post.title, user_post_path(post) %></h3>
      <p><%= post.body.truncate(50) %></p>
    </div>
  <% end %>

<% end %>

<br>

<%= link_to "トップへ戻る", root_path %>
