<h1>
  <% if @user.id == current_user.id %>
    マイページ
  <% else %>
    <%= @user.name %> の投稿一覧
  <% end %>
</h1>

<% if @user.id == current_user.id %>
  <p>ユーザー名：<%= @user.name %></p>
  <p>メールアドレス：<%= @user.email %></p>
<% end %>

<hr>

<% if @user.id == current_user.id %>
  <h2>あなたの投稿一覧</h2>
<% else %>
  <h2><%= @user.name %> の投稿一覧</h2>
<% end %>

<% @posts.each do |post| %>
  <div>
    <h3><%= link_to post.title, user_post_path(post) %></h3>
    <p><%= post.body.truncate(50) %></p>
  </div>
<% end %>

<hr>

<% if @user.id == current_user.id %>
  <%= link_to "ユーザー情報を編集する", edit_user_user_path(@user) %>

  <br><br>

  <%= link_to "退会する", user_user_path(@user),
              data: { turbo_method: :delete, confirm: "本当に退会しますか？" } %>
<% end %>

<br><br>

<%= link_to "トップへ戻る", root_path %>