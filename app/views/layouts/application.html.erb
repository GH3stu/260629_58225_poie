<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Poie" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :application, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body
    class="<%= 'post-form-page' if controller_path == 'user/posts' && %w[new edit].include?(action_name) %>"
    style="min-height: 100vh; display: flex; flex-direction: column; margin: 0;">

    <% unless controller_name == "homes" && action_name == "about" %>
      <%= render "layouts/header" %>
    <% end %>

    <div style="flex: 1; display: flex;">
      <% unless controller_name == "homes" && action_name == "about" %>
        <%= render "layouts/sidebar" %>
      <% end %>

  <!-- mainbody -->
      <% if controller_name == "homes" && action_name == "top" %>
        <main class="main-content" style="flex: 1; padding: 40px 60px; background-color: #FCFEFB;">
          <%= yield %>
        </main>
      <% elsif controller_name == "homes" && action_name == "about" %>
        <main class="main-content" style="flex: 1; padding: 0;">
          <%= yield %>
        </main>
      <% else %>
        <main class="main-content" style="flex: 1; padding: 40px 60px;">
          <%= yield %>
        </main>
      <% end %>
    </div>
    <% unless controller_name == "homes" && action_name == "about" %>
      <%= render "layouts/footer" %>
    <% end %>

  </body>
</html>
