<!DOCTYPE html>
<html>
  <head>
    <title>Admin</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>

    <%= render "layouts/header" %>

    <div style="display: flex;">
      <%= render "layouts/sidebar" %>   <!-- ★ これを追加 -->
      <div style="flex: 1; padding: 20px;">
        <%= yield %>
      </div>
    </div>

  </body>
</html>
