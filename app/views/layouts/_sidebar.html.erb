<div style="width: 200px; min-height: calc(100vh - 70px - 60px); 
            border-right: 1px solid #ddd; padding: 20px;
            background-color: #E6FFE9; color: #008000;">
  <h2 style="font-size: 24px; margin-top: 30px; margin-bottom: 36px;">
    Category
  </h2>

  <ul style="list-style: none; padding: 8px; color: #555;">
    <% Category.for_post_select.each do |category| %>
      <li style="margin-bottom: 15px;">
        <% if defined?(current_admin) && current_admin.present? %>
          <!-- 管理者：管理者投稿一覧へ -->
          <%= link_to category.name, admin_posts_path(category_id: category.id) %>

        <% elsif logged_in? %>
          <!-- ログインユーザー：ユーザー側カテゴリ投稿一覧へ -->
          <%= link_to category.name, category_posts_path(category) %>

        <% else %>
          <!-- 非ログインユーザー：管理者投稿一覧へ -->
          <%= link_to category.name, category_posts_path(category) %>
        <% end %>

      </li>
    <% end %>
  </ul>
</div>
