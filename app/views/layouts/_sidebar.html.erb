<div style="width: 200px; min-height: calc(100vh - 70px - 60px); border-right: 1px solid #ddd; padding: 20px;">
  <h3 style="font-size: 18px; margin-bottom: 15px;">Category</h3>

  <ul style="list-style: none; padding: 0; color: #555;">
    <% Category.for_post_select.each do |category| %>   <!-- ★ここを修正 -->
      <li style="margin-bottom: 10px;">
        <% if defined?(current_admin) && current_admin.present? %>
          <%= link_to category.name, admin_posts_path(category_id: category.id), style: "text-decoration: none;" %>
        <% else %>
          <%= link_to category.name, category_posts_path(category), style: "text-decoration: none;" %>
        <% end %>
      </li>
    <% end %>
  </ul>
</div>
