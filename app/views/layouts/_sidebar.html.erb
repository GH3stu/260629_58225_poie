<style>

/* PC：sidebar 全体 */
#sidebar {
  width: 200px;
  background-color: #E6FFE9;
  color: #008000;
  padding: 20px;
}

/* PC：タイトル（Category） */
#sidebar h2 {
  font-size: 28px;
  margin-top: 30px;
  margin-bottom: 40px;
}

/* PC：カテゴリ一覧の「・」を消す */
#sidebar ul {
  list-style: none;   /* ← これが効くようになる */
  padding: 8px;
  margin: 0;
}

/* PC：カテゴリ間隔 */
#sidebar li {
  margin-bottom: 18px;
}

/* PC：アイコン */
.sidebar-icon {
  width: 50px;
  height: auto;
}

/* スマホ */
@media (max-width: 768px) {

  #sidebar {
    width: 100%;
    position: fixed;
    top: 90px;
    left: 0;
    height: auto;
    padding: 10px 15px;
    z-index: 1500;
  }

  #sidebar h2 {
    font-size: 20px;
    margin-top: 20px;
    margin-bottom: 30px;
    text-align: center; /* ← スマホでも中央 */
  }

  #sidebar ul {
    padding: 4px;
  }

  #sidebar li {
    margin-bottom: 14px;
  }

  .sidebar-icon {
    width: 28px;
  }
}

</style>

<div id="sidebar" class="sidebar">

  <h2>Category</h2>

  <ul>
    <% Category.for_post_select.each do |category| %>
      <li>

        <% if category.name == "ポイント運用" %>
          <%= link_to image_tag("investment.png",
                alt: "ポイント運用",
                class: "sidebar-icon"), category_posts_path(category) %>
        <% else %>
          <%= link_to category.name, category_posts_path(category), style: "color: #65b844;" %>
        <% end %>

      </li>
    <% end %>
  </ul>
</div>
