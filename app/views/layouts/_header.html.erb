<header style="height: 90px; border-bottom: 1px solid #ddd; background-color: #F7FBEF;">
  <div style="height: 100%; display: flex; align-items: center; justify-content: space-between; padding: 0 40px;">

    <!-- 左：ロゴ + 検索窓 -->
    <div style="display: flex; align-items: center; gap: 80px;">
      <%= link_to about_path do %>
        <%= image_tag "poie_logo.jpg", alt: "Poie", style: "height: 80px;" %>
      <% end %>

      <!-- ★ ロゴ右に移動した検索窓（簡素化版） -->
      <%= form_with url: search_path, method: :get, local: true, style: "display: flex; align-items: center; gap: 10px;" do |f| %>
        <%= f.text_field :keyword, placeholder: "投稿を検索", style: "padding: 5px 10px; width: 200px;" %>
        <%= f.submit "検索", style: "padding: 5px 10px;" %>
      <% end %>
    </div>

    <nav style="display: flex; gap: 25px; font-size: 16px; align-items: center;">
    </nav>

    <!-- 右：ハンバーガーメニュー + ログイン前後切替 -->
    <div style="display: flex; align-items: center; gap: 20px;">
      <% if logged_in? && !(defined?(current_admin) && current_admin.present?) %>
        <div data-controller="hamburger" style="display: flex; align-items: center; gap: 20px;">
          <div class="hamburger-icon" data-action="click->hamburger#toggle" role="button" aria-label="メニュー">
            ☰
          </div>

          <div class="hamburger-menu" data-hamburger-target="menu">
            <ul>
              <li><%= link_to "マイページ", user_user_path(current_user) %></li>
              <li><%= link_to "プロフィール", edit_user_user_path(current_user) %></li>
              <li><%= link_to "ログアウト", logout_path, data: { turbo_method: :delete } %></li>
              <li><%= link_to "退会", user_user_path(current_user), data: { turbo_method: :delete, confirm: "本当に退会しますか？" } %></li>
            </ul>
          </div>
        </div>
      <% end %>

      <% if defined?(current_admin) && current_admin.present? %>
        <!-- ★ 管理者ログイン時 -->
        <%= link_to "管理者マイページ", admin_root_path %>
        <%= link_to "ログアウト", admin_logout_path, data: { turbo_method: :delete } %>

      <% elsif logged_in? %>
    <!-- ★ ユーザーログイン時（ハンバーガーで表示するのでここは空でOK） -->
    <!-- 右側の通常メニューは非表示のままでOK -->
      <% else %>
    <!-- ★ 非ログイン時（ここが復活する） -->
        <%= link_to "ログイン", login_path %>
        <%= link_to "新規登録", new_user_path %>
      <% end %>

    </div>

  </div>
</header>
