<header style="height: 90px; border-bottom: 1px solid #ddd;">
  <div style="height: 100%; display: flex; align-items: center; justify-content: space-between; padding: 0 40px;">

    <!-- 左：ロゴ -->
    <div>
      <%= link_to about_path do %>
        <%= image_tag "poie_logo.jpg", alt: "Poie", style: "height: 80px;" %>
      <% end %>
    </div>

    <!-- 中央ナビ（検索窓＋トップ） -->
    <nav style="display: flex; gap: 25px; font-size: 16px; align-items: center;">

      <!-- 検索窓（ログイン前も表示） -->
      <%= form_with url: search_path, method: :get, local: true, style: "display: flex; align-items: center; gap: 10px;" do |f| %>
        <%= f.select :match,
          [["部分一致", "partial"], ["完全一致", "exact"]],
          {}, style: "padding: 5px 10px;" %>

        <%= f.select :target,
          [["ユーザー", "users"], ["投稿", "posts"]],
          {}, style: "padding: 5px 10px;" %>

        <%= f.text_field :keyword, placeholder: "検索", style: "padding: 5px 10px; width: 180px;" %>
        <%= f.submit "検索", style: "padding: 5px 10px;" %>
      <% end %>

      <% unless defined?(current_admin) && current_admin.present? %>
        <span style="color: #aaa;">ー</span>
        <%= link_to "トップ", root_path %>
      <% end %>
    </nav>

    <!-- 右：ログイン前後で切り替え -->
    <div style="display: flex; gap: 20px; font-size: 16px;">

      <% if defined?(current_admin) && current_admin.present? %>
        <!-- ★ 管理者ログイン時 -->
        <%= link_to "管理者マイページ", admin_root_path %>
        <%= link_to "ログアウト", admin_logout_path, data: { turbo_method: :delete } %>

      <% elsif logged_in? %>
        <!-- ★ ユーザーログイン時 -->
        <%= link_to "マイページ", user_user_path(current_user) %>
        <%= link_to "新規投稿", new_user_post_path %>
        <%= link_to "投稿一覧", user_posts_path %>
        <%= link_to "ログアウト", logout_path, data: { turbo_method: :delete } %>

      <% else %>
        <!-- ★ 非ログイン時 -->
        <%= link_to "ログイン", login_path %>
        <%= link_to "新規登録", new_user_path %>
      <% end %>

    </div>

  </div>
</header>
