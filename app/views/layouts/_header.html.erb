<header>
  <%= link_to "Poie", root_path, style: "font-weight: bold; font-size: 20px;" %>

  <% if logged_in? %>
    <%= link_to "マイページ", user_path(current_user) %>
    <%= link_to "ログアウト", logout_path, data: { turbo_method: :delete } %> 
  <% else %> 
    <%= link_to "ログイン", login_path %>
    <%= link_to "新規登録", new_user_path %>
  <% end %>

</header>