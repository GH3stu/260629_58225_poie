<style>

/* ヘッダー全体 */
header {
  padding: 20px 0;
  background-color: #F7FBEF;
  border-bottom: 1px solid #F7FBEF;
}

/* スマホ */
@media (max-width: 768px) {
  header {
    padding: 10px 0;
  }
}

/* 左側（ロゴ＋検索） */
.header-left {
  display: flex;
  align-items: center;
  gap: 80px;
}

@media (max-width: 768px) {
  .header-left {
    gap: 20px;
  }
}

/* ロゴ */
.header-logo {
  height: 90px;
}

@media (max-width: 768px) {
  .header-logo {
    height: 50px;
  }
}

/* 検索窓 */
.search-input {
  width: 200px;
}

@media (max-width: 768px) {
  .search-input {
    width: 140px;
  }
}

/* アイコン */
.header-icon {
  width: 50px;
  height: auto;
}

@media (max-width: 992px) {
  .header-icon {
    width: 32px;
  }
}

@media (max-width: 768px) {
  .header-icon {
    width: 28px;
  }
}

</style>

<header>

  <div style="height: 100%; display: flex; align-items: center; justify-content: space-between; padding: 0 40px;">

    <!-- 左：ロゴ＋検索窓 -->
    <div class="header-left">
      <%= link_to about_path do %>
        <%= image_tag "poie_logo.png", alt: "Poie", class: "header-logo" %>
      <% end %>

      <!-- ★ ロゴ右の検索窓 -->
      <%= form_with url: search_path, method: :get, local: true,
        style: "display: flex; align-items: center; gap: 10px;" do |f| %>

        <%= f.text_field :keyword,
              placeholder: "投稿を検索",
              class: "search-input",
              style: "padding: 5px 10px; border: 2px solid #65b844; color: #65b844;" %>

        <style>
          input::placeholder { color: #808080; }
        </style>

        <%= button_tag type: "submit",
              style: "background: none; border: none; padding: 0; cursor: pointer;" do %>
          <%= image_tag "search.png", alt: "検索", class: "header-icon",
                style: "width: 30px; height: auto; margin-left: 10px;" %>
        <% end %>

      <% end %>
    </div>

    <!-- 中央ナビ（今は空） -->
    <nav style="display: flex; gap: 25px; font-size: 16px; align-items: center;">
    </nav>

    <!-- 右：カテゴリハンバーガー＋ユーザーメニュー -->
        <div data-controller="hamburger"
          style="display: flex; align-items: center; gap: 20px;">

      <% if logged_in? && !(defined?(current_admin) && current_admin.present?) %>

        <!-- ★ 左側カテゴリハンバーガー -->
        <div class="sidebar-toggle-icon" data-action="click->hamburger#toggleSidebar">
          <%= image_tag "hamburger_left.png",
              alt: "カテゴリ",
              class: "header-icon",
              style: "width: 30px; height: auto;" %>
        </div>

        <!-- ★ 右上ユーザーメニュー（アイコン＋メニュー本体を完全に内側へ統合） -->
        <div style="display: flex; align-items: center; gap: 20px; position: relative;">

          <!-- 新規投稿 -->
          <%= link_to image_tag(
                "post_new.png",
                alt: "新規投稿",
                class: "header-icon icon-post",
                style: "margin-right: 10px;"
              ), new_user_post_path %>


                    <!-- トップへ戻る -->
          <%= link_to image_tag(
                "home_top.png",
                alt: "トップへ戻る",
                class: "header-icon icon-home",
                style: "margin-right: 30px;"
              ), root_path %>

          <!-- ハンバーガーアイコン（親の中に入れる） -->
          <div class="hamburger-icon"
               data-action="click->hamburger#toggle"
               role="button"
               aria-label="メニュー">
            <%= image_tag(
                  "hamburger.png",
                  alt: "メニュー",
                  class: "header-icon",
                  style: "width: 30px; height: auto;"
                ) %>
          </div>

          <!-- ★ メニュー本体（必ず同じ div の中に入れる） -->
          <div class="header-dropdown-menu"
            data-hamburger-target="menu">

            <ul style="list-style: none; padding: 0; margin: 0;">
              <li><%= link_to "マイページ", user_user_path(current_user), style: "color: #65b844;" %></li>
              <li><%= link_to "プロフィール", edit_user_user_path(current_user), style: "color: #65b844;" %></li>
              <li><%= link_to "ログアウト", logout_path, data: { turbo_method: :delete }, style: "color: #65b844;" %></li>
              <li><%= link_to "退会", user_user_path(current_user),
                      data: { turbo_method: :delete, turbo_confirm: "本当に退会しますか？" },
                      style: "color: #65b844;" %></li>
            </ul>

          </div>

        </div>

      <% end %>

      <% if defined?(current_admin) && current_admin.present? %>
        <%= link_to "管理者マイページ", admin_root_path, style: "color: #65b844;" %>
        <%= link_to "ログアウト", admin_logout_path, data: { turbo_method: :delete }, style: "color: #65b844;" %>

      <% elsif logged_in? %>
        <!-- ユーザーログイン時：右側メニューはハンバーガーに統合済み -->

      <% else %>
        <!-- 非ログイン時：トップへ戻るアイコンも表示 -->
        <%= link_to image_tag(
              "home_top.png",
              alt: "トップへ戻る",
              class: "header-icon icon-home",
              style: "margin-right: 30px;"
            ), root_path %>

        <%= link_to "ログイン", login_path, style: "color: #65b844;" %>
        <%= link_to "新規登録", new_user_path, style: "color: #65b844;" %>
      <% end %>

    </div>

  </div>
</header>
