<h2><%= @purpose.name %> の投稿一覧</h2>

<% if @posts.any? %>
  <ul style="margin-top: 20px;">
    <% @posts.each do |post| %>
      <li style="margin-bottom: 20px;">

        <!-- タイトルリンク（ログイン状態で分岐） -->
        <% if logged_in? %>
          <!-- ログイン後：ユーザー投稿 or 管理者投稿に応じてリンクを分岐 -->
          <% if post.user_id.present? %>
            <strong><%= link_to post.title, user_post_path(post) %></strong>
          <% else %>
            <strong><%= link_to post.title, admin_post_path(post) %></strong>
          <% end %>
        <% else %>
          <!-- 非ログイン時：管理者投稿のみ表示されているので admin_post_path -->
          <strong><%= link_to post.title, admin_post_path(post) %></strong>
        <% end %>

        <br>
        <span>カテゴリ：<%= post.category.name %></span><br>
        <span>投稿者：<%= post.user&.name || post.admin&.name %></span><br>
        <span>投稿日時：<%= l(post.created_at, format: :long) %></span>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>投稿はまだありません。</p>
<% end %>
