<h2 style="color: #65b844;"><%= @purpose.name %> の投稿一覧</h2>

<% if @posts.any? %>

  <table style="width:100%; border-collapse: collapse; color: #65b844; margin-top:20px;">
    <thead>
      <tr style="border-bottom: 2px solid #65b844;">
        <th>日時</th>
        <th>タイトル</th>
        <th>カテゴリ</th>
        <th>投稿者</th>
        <th>詳細</th>
      </tr>
    </thead>

    <tbody>
      <% @posts.each do |post| %>
        <tr style="border-bottom: 1px solid #65b844;">

          <!-- 日時 -->
          <td><%= post.created_at.strftime("%Y-%m-%d %H:%M") %></td>

          <!-- タイトル（ログイン状態で分岐） -->
          <td>
            <% if logged_in? %>
              <% if post.user_id.present? %>
                <%= link_to post.title, user_post_path(post),
                  style:"color: #65b844; text-decoration:none;" %>
              <% else %>
                <%= link_to post.title, user_post_path(post),
                  style:"color: #65b844; text-decoration:none;" %>
              <% end %>
            <% else %>
              <%= link_to post.title, login_path,
                style:"color: #65b844; text-decoration:none;" %>
            <% end %>
          </td>

          <!-- カテゴリ -->
          <td><%= post.category.name %></td>

          <!-- 投稿者 -->
          <td>
            <% if post.user.present? %>
              <%= post.user.name %>
            <% else %>
              poier
            <% end %>
          </td>

          <!-- 詳細ボタン -->
          <td>
            <% if logged_in? %>
              <% if post.user_id.present? %>
                <%= link_to "詳細", user_post_path(post),
                  style:"
                    display:inline-block;
                    padding:6px 12px;
                    background-color: #65b844;
                    color: #fff;
                    border-radius:999px;
                    text-decoration:none;
                  " %>
              <% else %>
                <%= link_to "詳細", user_post_path(post),
                  style:"
                    display:inline-block;
                    padding:6px 12px;
                    background-color: #65b844;
                    color: #fff;
                    border-radius:999px;
                    text-decoration:none;
                  " %>
              <% end %>
            <% else %>
              <%= link_to "詳細", login_path,
                style:"
                  display:inline-block;
                  padding:6px 12px;
                  background-color: #65b844;
                  color: #fff;
                  border-radius:999px;
                  text-decoration:none;
                " %>
            <% end %>
          </td>

        </tr>
      <% end %>
    </tbody>
  </table>

<% else %>
  <p style="color:#65b844;">投稿はまだありません。</p>
<% end %>
