<h1>新規登録</h1>

<%= form_with model: @user, local: true do |f| %>

  <% if @user.errors.any? %>
    <ul>
      <% if @user.errors[:name].any? %>
        <li>ユーザー名 <%= @user.errors[:name].first %></li>
      <% end %>

      <% if @user.errors[:email].any? %>
        <li>メールアドレス <%= @user.errors[:email].first %></li>
      <% end %>

      <% if @user.errors[:password].any? %>
        <li>パスワード <%= @user.errors[:password].first %></li>
      <% end %>
    </ul>
  <% end %>

  <div>
    <%= f.label :name %>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :email %>
    <%= f.email_field :email %>
  </div>

  <div>
    <%= f.label :password %>
    <%= f.password_field :password %>
  </div>

  <div>
    <%= f.label :password_confirmation %>
    <%= f.password_field :password_confirmation %>
  </div>

  <%= f.submit "新規登録" %>
<% end %>
