<h2>poieユーザー 新規登録</h2>

<br>

<!-- ★ 左端に配置する入力ボックス（統一レイアウト） -->
<div style="width: 30%; height: 60vh; border: 1px solid #FFF; padding: 30px; background-color: #F7FBEF;">

  <%= form_with model: @user, local: true do |f| %>

    <% if @user.errors.any? %>
      <ul>
        <% if @user.errors[:name].any? %>
          <li>ユーザー名 <%= @user.errors[:name].first %></li>
        <% end %>

        <% if @user.errors[:email].any? %>
          <li>メールアドレス <%= @user.errors[:email].first %></li>
        <% end %>

        <% if @user.errors[:password].any? %>
          <li>パスワード <%= @user.errors[:password].first %></li>
        <% end %>
      </ul>
    <% end %>

    <div>
      <%= f.label :name, "ユーザー名" %><br>
      <%= f.text_field :name, style: "width: 100%;" %>
    </div>

    <br>

    <div>
      <%= f.label :email, "メールアドレス" %><br>
      <%= f.email_field :email, style: "width: 100%;" %>
    </div>

    <br>

    <div>
      <%= f.label :password, "パスワード" %><br>
      <%= f.password_field :password, style: "width: 100%;" %>
    </div>

    <br>

    <div>
      <%= f.label :password_confirmation, "パスワード確認" %><br>
      <%= f.password_field :password_confirmation, style: "width: 100%;" %>
    </div>

    <br>

    <%= f.submit "新規登録", style: "padding: 8px 20px;" %>

  <% end %>

</div>

<br>

<%= link_to "トップページへ戻る", root_path %>

