<h2 style="color: #65b844; text-align: center;">
  poieユーザー 新規登録
</h2>

<br><br>

<div style="
  max-width: 400px;
  margin: 0 auto;
  background-color: #F7FBEF;
  border: 1px solid #FFF;
  padding: 30px;
  border-radius: 8px;
">

  <%= form_with model: @user, local: true do |f| %>

    <% if @user.errors.any? %>
      <ul>
        <% if @user.errors[:name].any? %>
          <li>ユーザー名 <%= @user.errors[:name].first %></li>
        <% end %>

        <% if @user.errors[:email].any? %>
          <li>メールアドレス <%= @user.errors[:email].first %></li>
        <% end %>

        <% if @user.errors[:password].any? %>
          <li>パスワード <%= @user.errors[:password].first %></li>
        <% end %>
      </ul>
    <% end %>

    <div>
      <%= f.label :name, "ユーザー名",
            style:"color:#65b844;" %><br>
      <%= f.text_field :name,
            style:"width:100%; color:#65b844; border:1px solid #65b844;" %>
    </div>

    <br>

    <div>
      <%= f.label :email, "メールアドレス",
            style:"color:#65b844;" %><br>
      <%= f.email_field :email,
            style:"width:100%; color:#65b844; border:1px solid #65b844;" %>
    </div>

    <br>

    <div>
      <%= f.label :password, "パスワード",
            style:"color:#65b844;" %><br>
      <%= f.password_field :password,
            style:"width:100%; color:#65b844; border:1px solid #65b844;" %>
    </div>

    <br>

    <div>
      <%= f.label :password_confirmation, "パスワード確認",
            style:"color:#65b844;" %><br>
      <%= f.password_field :password_confirmation,
            style:"width:100%; color:#65b844; border:1px solid #65b844;" %>
    </div>

    <br>

    <div>
      <%= f.label :goal_point, "目標ポイント数（任意）", style:"color:#65b844;" %><br>
      <%= f.number_field :goal_point,
            style:"width:100%; color:#65b844; border:1px solid #65b844;" %>
    </div>

    <br><br>

  <%= f.submit "新規登録",
    style: "
      width: 100%;
      padding: 10px 0;
      background-color: #65b844;
      color: #fff;
      border: none;
      border-radius: 999px;
      font-size: 18px;
      text-align: center;
      cursor: pointer;
    "
  %>

  <% end %>

</div>
