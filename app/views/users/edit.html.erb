<h1>ユーザー情報編集</h1>

<%= form_with model: @user, local: true do |f| %>

  <% if @user.errors.any? %>   <!-- # エラー表示 -->
    <ul>
      <% @user.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  <% end %>

  <div>
    <%= f.label :name, "ユーザー名" %>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :email, "メールアドレス" %>
    <%= f.email_field :email %>
  </div>

  <%= f.submit "更新する" %>
<% end %>

<%= link_to "戻る", user_path(@user) %>