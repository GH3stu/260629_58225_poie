<h1>
  <% if @user.id == current_user.id %>
    マイページ
  <% else %>
    <%= @user.name %> の投稿一覧
  <% end %>
</h1>

<% if @user.id == current_user.id %>
  <p>ユーザー名：<%= @user.name %></p>
  <p>メールアドレス：<%= @user.email %></p>
<% end %>

<hr>

<% if @user.id == current_user.id %>
  <h2>あなたの投稿一覧</h2>
<% end %>

<% @posts.each do |post| %>
  <div>
    <h3><%= link_to post.title, post_path(post) %></h3>
    <p><%= post.body.truncate(50) %></p>
  </div>
<% end %>

<hr>

<% if @user.id == current_user.id %>
  <%= link_to "新規投稿", new_post_path %>   <!-- # 新規投稿リンク（ここに追加） -->

  <br><br>

  <%= link_to "ユーザー情報編集", edit_user_path(@user) %>   <!-- # 順番2 -->

  <br><br>

  <%= link_to "退会する", user_path(@user),
              method: :delete,
              data: { confirm: "本当に退会しますか？" } %>        <!-- # 順番3 -->
<% end %>

<br><br>

<%= link_to "トップへ戻る", root_path %>