<h2>ログイン</h2>

<br>

<!-- ★ 左端に配置する入力ボックス（統一レイアウト） -->
<div style="width: 30%; height: 40vh; border: 1px solid #FFF; padding: 30px; background-color: #F7FBEF;">

  <%= form_with url: login_path, local: true do |f| %>

    <% if flash[:alert] %>
      <p><%= flash[:alert] %></p>
    <% end %>

    <div>
      <%= f.label :email, "メールアドレス" %><br>
      <%= f.email_field :email, style: "width: 100%;" %>
    </div>

    <br>

    <div>
      <%= f.label :password, "パスワード" %><br>
      <%= f.password_field :password, style: "width: 100%;" %>
    </div>

    <br>

    <%= f.submit "ログイン", style: "padding: 8px 20px;" %>

  <% end %>

</div>

<br>

<%= link_to "トップページへ戻る", root_path %>
