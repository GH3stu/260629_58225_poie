<h2 style="color: #65b844; text-align: center;">
  poieユーザー ログイン
</h2>

<br><br>

<div style="
  max-width: 400px;
  margin: 0 auto;
  background-color: #F7FBEF;
  border: 1px solid #FFF;
  padding: 30px;
  border-radius: 8px;
">

  <%= form_with url: login_path, local: true do |f| %>

    <% if flash[:alert] %>
      <p><%= flash[:alert] %></p>
    <% end %>

    <div>
      <%= f.label :email, "メールアドレス", style: "color: #65b844;" %>
      <%= f.email_field :email,
      style:"width:100%; color:#65b844; border:1px solid #65b844;" %>
    </div>

    <br>

    <div>
      <%= f.label :password, "パスワード", style: "color: #65b844;" %><br>
      <%= f.password_field :password,
      style:"width:100%; color:#65b844; border:1px solid #65b844;" %>
    </div>

    <br>
    <%= link_to "パスワードを忘れた場合はこちら", new_password_reset_path %>
    <br><br>

  <%= f.submit "ログイン",
    style: "
      width: 100%;
      padding: 10px 0;
      background-color: #65b844;
      color: #fff;
      border: none;
      border-radius: 999px;
      font-size: 18px;
      text-align: center;
      cursor: pointer;
    "
  %>


  <% end %>

</div>
